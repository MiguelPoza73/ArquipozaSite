---
pagination:
  data: collections.proyectos
  size: 1
  alias: p
permalink: "portfolio/{{ p.page.fileSlug }}/"
root: "../../"
eleventyComputed:
  title: "{{ p.data.titulo }}"
---
{%- set d = p.data -%}
<!DOCTYPE html>
<html lang="es" style="height: auto;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ d.titulo }} · Arquipoza - Estudio de Arquitectura</title>
    <meta name="description" content="{{ d.titulo }} — proyecto {{ d.tipo | lower }} en {{ d.ubicacion }} ({{ d.anio }}). Arquipoza, estudio de arquitectura." />
    <link rel="stylesheet" href="{{ root }}assets/bootstrap.css" />
    <link rel="stylesheet" href="{{ root }}assets/arquipoza.css" />
    <link rel="stylesheet" href="{{ root }}assets/current-project.css" />
    <link rel="stylesheet" href="{{ root }}assets/portfolio.css" />
    <style>
        article.content-item.page header h1 { display: none; }
        html { height: auto !important; }
    </style>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='-30 -62.0 101 101'%3E%3Crect x='-30' y='-62.0' width='101' height='101' fill='%230f0f0f'/%3E%3Cg fill='none' stroke='%23b8966e' stroke-width='1.4' stroke-opacity='0.45'%3E%3Crect x='0' y='1' width='2' height='2'/%3E%3Crect x='-3' y='0' width='3' height='3'/%3E%3Crect x='-3' y='-5' width='5' height='5'/%3E%3Crect x='2' y='-5' width='8' height='8'/%3E%3Crect x='-3' y='3' width='13' height='13'/%3E%3Crect x='-24' y='-5' width='21' height='21'/%3E%3Crect x='-24' y='-39' width='34' height='34'/%3E%3Crect x='10' y='-39' width='55' height='55'/%3E%3Crect x='-24' y='-39' width='89' height='55'/%3E%3C/g%3E%3Cpath d='M0 1A1 1 0 0 1 1 0A1 1 0 0 1 2 1A2 2 0 0 1 0 3A3 3 0 0 1 -3 0A5 5 0 0 1 2 -5A8 8 0 0 1 10 3A13 13 0 0 1 -3 16A21 21 0 0 1 -24 -5A34 34 0 0 1 10 -39A55 55 0 0 1 65 16' fill='none' stroke='%23b8966e' stroke-width='4.5' stroke-linecap='round'/%3E%3C/svg%3E" />
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="{{ root }}" style="display:flex; align-items:center; gap:0.8rem; text-decoration:none;">
                <svg class="brand-mark" width="54" height="34" viewBox="-25.5 -40.5 92.0 58.0" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><g fill="none" stroke="#b8966e" stroke-width="0.9" stroke-opacity="0.38"><rect x="0" y="1" width="2" height="2"/><rect x="-3" y="0" width="3" height="3"/><rect x="-3" y="-5" width="5" height="5"/><rect x="2" y="-5" width="8" height="8"/><rect x="-3" y="3" width="13" height="13"/><rect x="-24" y="-5" width="21" height="21"/><rect x="-24" y="-39" width="34" height="34"/><rect x="10" y="-39" width="55" height="55"/><rect x="-24" y="-39" width="89" height="55"/></g><path d="M0 1A1 1 0 0 1 1 0A1 1 0 0 1 2 1A2 2 0 0 1 0 3A3 3 0 0 1 -3 0A5 5 0 0 1 2 -5A8 8 0 0 1 10 3A13 13 0 0 1 -3 16A21 21 0 0 1 -24 -5A34 34 0 0 1 10 -39A55 55 0 0 1 65 16" fill="none" stroke="#b8966e" stroke-width="3" stroke-linecap="round"/></svg>
                <span>Arquipoza</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ root }}">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ root }}portfolio/">Proyectos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ root }}sketchbook/">Bocetos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ root }}about/">Estudio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ root }}contact/">Contacto</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ root }}quote/">Presupuesto</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <main>
<div class="container my-5 pf-detail">
    <a href="{{ root }}portfolio/" style="color: var(--color-secondary); font-size: 0.75rem; letter-spacing: 3px; text-transform: uppercase; text-decoration: none;">
        ← Volver a proyectos
    </a>

    <div class="row mt-4">
        <div class="col-md-8">
            {% if d.portada %}
            <button type="button" class="pf-shot pf-shot--main" data-index="0" aria-label="Ampliar foto: {{ d.titulo }}">
                <img decoding="async" src="{{ d.portada | rel(root) }}" alt="{{ d.titulo }}" style="width: 100%; height: 500px; object-fit: cover;" />
            </button>
            {% endif %}
        </div>
        <div class="col-md-4">
            <h1 style="font-family: var(--font-heading); color: var(--color-light); letter-spacing: 4px; font-weight: 300; font-size: 2.5rem; margin-bottom: 2rem;">
                {{ d.titulo }}
            </h1>

            <div style="border-left: 2px solid var(--color-secondary); padding-left: 1.5rem;">
                {% for campo in [["Cliente", d.cliente], ["Ubicación", d.ubicacion], ["Año", d.anio], ["Tipo", d.tipo]] %}{% if campo[1] %}
                <p style="color: var(--color-secondary); font-size: 0.7rem; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 0.3rem;">{{ campo[0] }}</p>
                <p style="color: var(--color-light); margin-bottom: 1.5rem;">{{ campo[1] }}</p>
                {% endif %}{% endfor %}
                {% if d.superficie %}
                <p style="color: var(--color-secondary); font-size: 0.7rem; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 0.3rem;">Superficie</p>
                <p style="color: var(--color-light); margin-bottom: 1.5rem;">{{ d.superficie | miles }} m²</p>
                {% endif %}
            </div>

            <a href="{{ root }}quote/" style="display: inline-block; margin-top: 2rem; background: transparent; border: 1px solid var(--color-secondary); color: var(--color-secondary); padding: 0.8rem 2rem; font-size: 0.75rem; letter-spacing: 3px; text-transform: uppercase; text-decoration: none;">
                Solicitar presupuesto
            </a>
        </div>
    </div>

    {% if p.templateContent | trim %}
    <div class="pf-desc">{{ p.templateContent | safe }}</div>
    {% endif %}

    {% if d.galeria and d.galeria.length %}
    <section class="pf-gallery" aria-label="Galería de fotos">
        <p class="pf-gallery__eyebrow">Galería · {{ (d.galeria.length + 1) | pad }} fotos</p>
        <div class="pf-gallery__grid">
            {% for f in d.galeria %}
            <button type="button" class="pf-shot" data-index="{{ loop.index }}" aria-label="Ampliar foto {{ loop.index + 1 }}">
                <img loading="lazy" decoding="async" src="{{ f.imagen | rel(root) }}" alt="{{ f.alt or d.titulo }}" data-caption="{{ f.pie }}" />
            </button>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    <div id="lightbox" class="cp-lightbox pf-lightbox" role="dialog" aria-modal="true" aria-label="Foto ampliada" aria-hidden="true">
        <button type="button" class="close">CERRAR ✕</button>
        <button type="button" class="cp-arrow prev" aria-label="Foto anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
        <img src="" alt="">
        <p></p>
        <button type="button" class="cp-arrow next" aria-label="Foto siguiente"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
    </div>
</div>
    </main>
    <footer>
        <div class="container">
            <p>© 2026 Arquipoza. Estudio de Arquitectura.</p>
        </div>
    </footer>
    <script src="{{ root }}assets/bootstrap.js"></script>
<script src="{{ root }}assets/site.js" defer></script>
<script src="{{ root }}assets/gallery.js" defer></script></body>
</html>