@using OrchardCore.ContentManagement
@using Arquipoza.Module.Models
@model OrchardCore.ContentManagement.ContentItem

@{
    var part = Model.As<ProjectPart>();
}

<div class="container my-5">
    <a href="/portfolio" style="color: var(--color-secondary); font-size: 0.75rem; letter-spacing: 3px; text-transform: uppercase; text-decoration: none;">
        ← Back to Portfolio
    </a>

    <div class="row mt-4">
        <div class="col-md-8">
            @if (!string.IsNullOrEmpty(part.ImageUrl))
            {
                <img src="@part.ImageUrl" alt="@Model.DisplayText" style="width: 100%; height: 500px; object-fit: cover;" />
            }
        </div>
        <div class="col-md-4">
            <h1 style="font-family: var(--font-heading); color: var(--color-light); letter-spacing: 4px; font-weight: 300; font-size: 2.5rem; margin-bottom: 2rem;">
                @Model.DisplayText
            </h1>

            <div style="border-left: 2px solid var(--color-secondary); padding-left: 1.5rem;">
                <p style="color: var(--color-secondary); font-size: 0.7rem; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 0.3rem;">Client</p>
                <p style="color: var(--color-light); margin-bottom: 1.5rem;">@part.ClientName</p>

                <p style="color: var(--color-secondary); font-size: 0.7rem; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 0.3rem;">Location</p>
                <p style="color: var(--color-light); margin-bottom: 1.5rem;">@part.Location</p>

                <p style="color: var(--color-secondary); font-size: 0.7rem; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 0.3rem;">Year</p>
                <p style="color: var(--color-light); margin-bottom: 1.5rem;">@part.Year</p>

                <p style="color: var(--color-secondary); font-size: 0.7rem; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 0.3rem;">Type</p>
                <p style="color: var(--color-light); margin-bottom: 1.5rem;">@part.ProjectType</p>

                <p style="color: var(--color-secondary); font-size: 0.7rem; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 0.3rem;">Surface</p>
                <p style="color: var(--color-light); margin-bottom: 1.5rem;">@part.Surface</p>

                @if (part.IsFeatured)
                {
                    <span class="badge bg-warning">Featured</span>
                }
            </div>

            <a href="/quote" style="display: inline-block; margin-top: 2rem; background: transparent; border: 1px solid var(--color-secondary); color: var(--color-secondary); padding: 0.8rem 2rem; font-size: 0.75rem; letter-spacing: 3px; text-transform: uppercase; text-decoration: none;">
                Request a Quote
            </a>
        </div>
    </div>
</div>